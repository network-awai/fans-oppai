(ns support-worker-test
  "Support-worker integration test. The store was D1 (node:sqlite shim over
  migrations/0001_feedback.sql); ADR-2609132007 moved it to R2, so this file
  now runs against an in-memory R2 shim with the same semantics the worker
  exercises: get/put/list/delete, with the expiry living inside the record
  (:expires-at, checked by oppai.gen.r2store on read)."
  (:require ["node:assert/strict" :as assert]
            ["node:url" :as url]
            ["node:path" :as path]))

(def ^:private ^:dynamic *store* (atom {}))
(defn r2-reset! [] (reset! *store* {}))
(defn r2-objs []
  (->> @*store*
       (map (fn [[k v]] #js {:key k :value v}))
       (into-array)))
(def r2 #js {:get (fn [k]
                    (js/Promise.resolve
                     (when-let [v (get @*store* k)]
                       #js {:text (fn [] (js/Promise.resolve v))})))
             :put (fn [k v]
                    (swap! *store* assoc k v)
                    (js/Promise.resolve nil))
             :delete (fn [k]
                       (swap! *store* dissoc k)
                       (js/Promise.resolve nil))
             :list (fn [opts]
                     (js/Promise.resolve
                      #js {:objects (->> @*store*
                                         (filter (fn [[k _]] (.startsWith k (.-prefix opts))))
                                         (map (fn [[k _]] #js {:key k}))
                                         (into-array))}))})
(def pending (atom []))
(def ctx #js {:waitUntil #(swap! pending conj %)})
(def env #js {:OPPAI_R2 r2 :OPPAI_PREVIEW_SPONSOR_TOKEN "test-only-secret"})
(def sent (atom []))
(set! (.-fetch js/globalThis)
      (fn [target init]
        (swap! sent conj (js->clj (.-headers init)))
        (js/Promise.resolve
         (if (.includes target "/preview/video")
           (js/Response. "{\"status\":\"done\",\"artifactUrl\":\"/api/v1/preview/video/jobs/9cd52d7c-8727-4f96-aa96-df891fe03caf/artifact\"}")
           (js/Response. "{\"error\":{\"code\":\"daily_limit\",\"message\":\"quota\"}}" #js {:status 429})))))
(defn request [path body ip]
  (js/Request. (str "https://oppai.fans" path)
               #js {:method "POST" :headers #js {"origin" "https://oppai.fans" "content-type" "application/json" "cf-connecting-ip" ip "x-preview-network" "forged"}
                    :body (js/JSON.stringify (clj->js body))}))
(def valid {:category "bug" :message "first visit quota issue" :page "#image" :error_id ""})
(def free {:model "waiREALMIX_v11" :prompt "DO_NOT_LOG_PROMPT" :publication_consent "public-examples-v1"})
(defn call! [worker path body ip expected]
  (-> (.fetch worker (request path body ip) env ctx)
      (.then (fn [r] (assert/equal (.-status r) expected) (.json r)))))
(-> (js/eval (str "import(" (js/JSON.stringify (str (url/pathToFileURL (path/resolve "dist/worker.js")))) ")"))
    (.then (fn [module]
             (let [worker (.-default module)]
               (-> (reduce (fn [p _] (.then p #(call! worker "/api/feedback" valid "192.0.2.1" 201))) (js/Promise.resolve) (range 10))
                   (.then #(call! worker "/api/feedback" valid "192.0.2.1" 429))
                   (.then #(call! worker "/api/feedback" valid "192.0.2.2" 201))
                   (.then #(call! worker "/api/feedback" (assoc valid :message "") "192.0.2.2" 400))
                   (.then #(call! worker "/api/feedback" (assoc valid :message (apply str (repeat 9000 "x"))) "192.0.2.2" 503))
                   (.then #(call! worker "/api/free/image" free "192.0.2.1" 429))
                   (.then (fn [body] (assert/match (.-request_id body) #"^[a-f0-9-]{36}$") (call! worker "/api/free/image" free "192.0.2.2" 429)))
                   (.then (fn [_] (call! worker "/api/free/video" {:model "10eros-max"} "192.0.2.1" 200)))
                   (.then (fn [body] (assert/equal (.-artifactUrl body) "/api/free/video/jobs/9cd52d7c-8727-4f96-aa96-df891fe03caf/artifact")))
                   (.then (fn [_]
                            (assert/notEqual (get (first @sent) "x-preview-network") (get (second @sent) "x-preview-network"))
                            (assert/match (get (first @sent) "x-preview-network") #"^[a-f0-9]{64}$")
                            (assert/notEqual (get (first @sent) "x-preview-network") "forged")
                            (js/Promise.all (to-array @pending))))
                   (.then (fn [_]
                            ;; persistence: 11 feedback objects + at least 1 site-error object
                            (let [fb (count (filter #(.startsWith % "feedback/") (keys @*store*)))
                                  errs (count (filter #(.startsWith % "site-errors/") (keys @*store*)))]
                              (assert/equal fb 11)
                              (assert/ok (pos? errs))
                              ;; privacy: prompt, IP and message text never reach the store
                              (let [blob (->> @*store*
                                              (filter (fn [[k _]] (.startsWith k "site-errors/")))
                                              (map (fn [[_ v]] v))
                                              (into-array)
                                              (js/JSON.stringify))]
                                (assert/equal (.includes blob "DO_NOT_LOG_PROMPT") false)
                                (assert/equal (.includes blob "192.0.2.") false)
                                (assert/equal (.includes blob "first visit") false)
                                (assert/equal (.includes blob "daily_limit") true))))
                   (.then (fn [_]
                            ;; retention: backdate every record, run the cron, expect empty
                            (doseq [[k _] @*store*]
                              (when-not (.startsWith k "feedback-count")
                                (let [v (js/JSON.parse (get @*store* k))]
                                  (when (.-created-at v) (set! (.-created-at v) 0))
                                  (when (.-expires-at v) (set! (.-expires-at v) 0))
                                  (swap! *store* assoc k (js/JSON.stringify v)))))
                            (.scheduled worker nil env ctx)
                            (js/Promise.all (to-array @pending))))
                   (.then (fn [_]
                            (let [fb (count (filter #(.startsWith % "feedback/") (keys @*store*)))
                                  errs (count (filter #(.startsWith % "site-errors/") (keys @*store*)))]
                              (assert/equal fb 0)
                              (assert/equal errs 0))
                            (println "Support integration passed: persistence, limits, isolation, spoof rejection, privacy, retention, error IDs")
                            (r2-reset!))))))))
    (.catch (fn [e] (.error js/console e) (js/process.exit 1)))))
