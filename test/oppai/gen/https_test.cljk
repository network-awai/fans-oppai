(ns oppai.gen.https-test
  "Both directions of the HTTPS requirement, with the reason pinned: a test
  that only asserted 'some redirect' would pass on a www->apex redirect too."
  (:require [clojure.test :refer [deftest is]]
            [oppai.gen.https :as https]))

(deftest plain-http-url-is-redirected
  (let [r (https/https-redirect "http://oppai.fans/#image" nil "GET")]
    (is (= 301 (:status r)))
    (is (= "https://oppai.fans/#image" (:location r))))
  (is (= 301 (:status (https/https-redirect "http://www.oppai.fans/" nil "HEAD")))))

(deftest cf-visitor-http-is-redirected-even-when-the-url-reads-https
  ;; TLS terminated at the edge: request.url says https, cf-visitor says http.
  (let [r (https/https-redirect "https://oppai.fans/api/free/image"
                                "{\"scheme\":\"http\"}" "POST")]
    (is (= 308 (:status r)) "a POST must not be turned into a GET by a 301")
    (is (= "https://oppai.fans/api/free/image" (:location r)))))

(deftest https-requests-are-not-redirected
  (is (nil? (https/https-redirect "https://oppai.fans/" nil "GET")))
  (is (nil? (https/https-redirect "https://oppai.fans/" "{\"scheme\":\"https\"}" "GET")))
  (is (nil? (https/https-redirect "https://oppai.fans/" "not json" "GET"))
      "an unparseable cf-visitor is not evidence of http"))

(deftest hsts-is-one-year-with-subdomains-and-no-preload
  (is (= "max-age=31536000; includeSubDomains" https/hsts-value))
  (is (nil? (https/redirect-response nil))))
