(ns net-free-stream-test
  (:require [oppai.gen.net :as net]))

(defn assert! [condition label]
  (when-not condition (throw (js/Error. label))))

(def image "data:image/png;base64,iVBORtest")
(def complete (str "event: complete\ndata: " (js/JSON.stringify #js {:image image}) "\n\n"))

(defn run! [chunks status content-type expected]
  (set! (.-fetch js/globalThis)
        (fn [_ init]
          (assert! (= "POST" (.-method init)) "must POST")
          (js/Promise.resolve
           (js/Response.
            (js/ReadableStream.
             #js {:start (fn [controller]
                           (doseq [chunk chunks]
                             (.enqueue controller (.encode (js/TextEncoder.) chunk)))
                           (.close controller))})
            #js {:status status :headers #js {"content-type" content-type}}))))
  (js/Promise.
   (fn [resolve reject]
     (net/submit-free-image!
      {:body {:prompt "teapot"}
       :on-ok (fn [result]
                (if (and (= expected :ok) (= image (:image result)))
                  (resolve true) (reject (js/Error. "unexpected success"))))
       :on-error (fn [message]
                   (if (and (= expected :error) (seq message))
                     (resolve true) (reject (js/Error. (str "unexpected error: " message)))))}))))

(-> (run! [(str "event: ping\ndata: {}\n\n" complete)] 200 "text/event-stream" :ok)
    (.then #(run! [(subs complete 0 10) (subs complete 10 28) (subs complete 28)] 200 "text/event-stream" :ok))
    (.then #(run! [(str "event: error\ndata: {\"error\":{\"code\":\"preview_unavailable\"}}\n\n")] 200 "text/event-stream" :error))
    (.then #(run! ["event: ping\ndata: {}\n\n"] 200 "text/event-stream" :error))
    (.then #(run! [(js/JSON.stringify #js {:image image})] 200 "application/json" :ok))
    (.then #(run! ["{\"error\":{\"code\":\"daily_limit\"}}"] 429 "application/json" :error))
    (.then #(do (println "Free image streaming: complete, split chunks, heartbeat, error, truncation, JSON and quota passed")
                (js/process.exit 0)))
    (.catch #(do (js/console.error %) (js/process.exit 1))))
