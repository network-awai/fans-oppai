(require '[producer-review :as r])
(try
  (-> (r/run! (first *command-line-args*))
      (.then #(println (js/JSON.stringify (clj->js %))))
      (.catch (fn [e] (.error js/console (.-message e)) (set! (.-exitCode js/process) 1))))
  (catch :default e (.error js/console (.-message e)) (set! (.-exitCode js/process) 1)))
