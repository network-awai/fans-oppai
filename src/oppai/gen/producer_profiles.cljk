(defn by-id [id] (some #(when (= id (:id %)) %) profiles))
(defn prompt [profile n]
  ;; Explicit profiles (owner-reviewed 2026-09-22) are consenting-fictional-adult
  ;; scenes; the studio bot banks (:act in bots/oppai-studio.edn) set the
  ;; vocabulary precedent. Everything else keeps the non-explicit floor.
  (if (:explicit? profile)
    (str "masterpiece, best quality, fictional adult age 32, adult woman, "
         (:cue profile) ", "
         (str "scene: " (:keyword profile))
         ", " (nth ["full body, cinematic evening light" "close-up, face focus, depth of field"
                    "pov, from above, looking at viewer"] (mod n 3))
         ", rating:explicit, no text")
    (str "masterpiece, best quality, fictional adult age 32, fully clothed, "
         (:cue profile) ", "
         (case (:keyword profile)
           "blonde-hair" "blonde hair"
           "sci-fi" "space station, futuristic city"
           "fantasy" "enchanted forest, traveling cloak"
           "dotpixel" "pixel art, visible pixel grid"
           "outdoor" "botanical garden, trees"
           "cosplay" "original space explorer costume"
           "uniform" "adult professional wearing a tailored hotel uniform"
           "stockings" "opaque stockings, knee length skirt, buttoned coat"
           (str "theme: " (:keyword profile)))
         ", " (nth ["waist up portrait, soft daylight" "full body, warm studio light"
                    "three quarter portrait, cinematic evening light"] (mod n 3))
         ", non-explicit, no nudity, no text")))

(defn choose [history]
  ;; Lowest successful count first; rotate ties by last attempt, then stable ID.
  ;; An outage doesn't count as a success or starve the remaining profiles.
  ;; Only non-explicit profiles are eligible: the hourly automation publishes a
  ;; non-explicit, fully-clothed gallery (docs/support.md contract), and explicit
  ;; profiles would otherwise never earn a success and clog the front of this sort.
  (first
    (sort-by (fn [p]
               (let [xs (filter #(= (:id p) (:profile %)) history)]
                 [(count (filter #(#{"generated" "deployed" "published"} (:state %)) xs))
                  (or (last (sort (keep :hour xs))) "") (:id p)]))
             (remove :explicit? profiles))))
